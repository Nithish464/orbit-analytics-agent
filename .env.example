# Optional local Ollama integration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# SQLite database path (default: backend/orbit.db)
ORBIT_DB_PATH=./backend/orbit.db

# Comma-separated frontend origins allowed by FastAPI
ORBIT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Vite proxy target for local development
ORBIT_BACKEND_URL=http://127.0.0.1:8000
